node_modules/
.DS_Store

# Character art pipeline. The scripts in "glb files/" are kept because they
# are how character-s.glb was made and how the next one will be; the models
# they read and write are not — the 21 MB sculpt, the decimation ladder and
# the Mixamo FBX downloads are sources and intermediates, and the only
# output the game needs is already in public/characters/.
glb files/*.glb
glb files/*.obj
glb files/rig/
animations/

# Source art, not runtime. The game only ever loads from public/ — these are
# the original Kenney downloads the served copies were cut from, and they
# stay on disk for whoever needs to cut another one.
kenney_*/
"glb files"/

# The soundtrack source, at the repo root. ANCHORED with a leading slash:
# a bare "music/" matches at every level and would take public/music/ —
# the copy the game actually serves — with it.
/music/
