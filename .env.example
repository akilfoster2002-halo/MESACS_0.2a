# =====================================================================
# KORO — the environment. Copy this to `.env` and fill in what you need.
#
#     cp .env.example .env
#
# `.env` is git-ignored and never leaves the machine. On Render these
# same names go in the dashboard instead and there is no file at all —
# real environment variables always win over this file, so a stray .env
# on a server cannot quietly override what the dashboard says.
#
# Every one of these is OPTIONAL. The game runs with none of them set;
# it just runs with less of itself switched on.
# =====================================================================

# THE TUTOR — the 💬 Ask button in the block editor.
# Without this the button never appears and nothing else changes.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# THE DATABASE — sign-in, saved progress, the arcade and the rooms.
# Without it the game still plays; sign-in reports itself offline.
# `npm run dev` fakes this in memory, so you do not need it to develop.
DATABASE_URL=

# SESSIONS. Any long random string. Left empty, a new one is generated
# at boot — fine on a laptop, but it signs everybody out every restart,
# so a deployed server wants a real one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The code somebody must type to register as a TEACHER rather than a
# student. Empty means nobody can.
TEACHER_CODE=

# The port to serve on. Defaults to 3000; `npm run dev` uses 8799.
PORT=

# `npm run dev` signs every request in as a local developer so the
# features behind sign-in can be looked at without an account. Set this
# to 0 to get the signed-out behaviour back — the 401s, the "not signed
# in" message, what a visitor sees. It does nothing on a deployed server,
# which never loads the dev harness.
DEV_SIGNED_IN=
